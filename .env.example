# Optional Supabase Auth + progress runtime.
# Use the project URL and publishable/anon-safe key. Never use the service role key in browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Optional Expo native app identity, EAS project linkage, and store versioning.
# Set these before creating Play Console and App Store Connect app records.
EXPO_APP_NAME=Codematica
EXPO_APP_SLUG=codematica
EXPO_APP_SCHEME=codematica
EXPO_APP_IDENTIFIER=com.codematica.app
EXPO_APP_VERSION=0.1.0
EXPO_IOS_BUILD_NUMBER=1
EXPO_ANDROID_VERSION_CODE=1
EXPO_OWNER=
EAS_PROJECT_ID=

# Optional Expo native Auth + progress runtime.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false
EXPO_PUBLIC_WEB_BASE_URL=
# Legacy fallback for app.config.ts; prefer EAS_PROJECT_ID for new setup.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional local Supabase content sync only.
# Do not expose the service role key to browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
