{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@codematica/core": ["../../packages/core/src/index.ts"],
      "@codematica/core/*": ["../../packages/core/src/*"],
      "@codematica/ui": ["../../packages/ui/src/index.ts"],
      "@codematica/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts",
    "expo-env.d.ts"
  ]
}
