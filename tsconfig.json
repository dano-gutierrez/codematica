{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ],
      "@codematica/core": [
        "./packages/core/src/index.ts"
      ],
      "@codematica/core/*": [
        "./packages/core/src/*"
      ],
      "@codematica/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@codematica/ui/*": [
        "./packages/ui/src/*"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web/.next"
  ]
}
