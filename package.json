{
  "name": "codematica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run dev -w @codematica/web",
    "web:dev": "npm run dev -w @codematica/web",
    "web:build": "npm run build -w @codematica/web",
    "web:start": "npm run start -w @codematica/web",
    "build": "npm run brand:assets && npm run game:runtime && npm run game:assets && npm run content:index && npm run build -w @codematica/web",
    "start": "npm run start -w @codematica/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck -w @codematica/core && npm run typecheck -w @codematica/ui && npm run typecheck -w @codematica/web && npm run typecheck -w @codematica/mobile && npm run typecheck:linkedin",
    "typecheck:linkedin": "tsc --noEmit -p scripts/linkedin/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && vitest run --coverage --config vitest.per-file.config.ts",
    "test:watch": "vitest",
    "test:mobile": "npm run test -w @codematica/mobile",
    "test:mobile:coverage": "npm run test -w @codematica/mobile -- --coverage --runInBand",
    "test:db": "supabase test db",
    "mobile:dev": "npm run dev -w @codematica/mobile",
    "mobile:android": "npm run android -w @codematica/mobile",
    "mobile:ios": "npm run ios -w @codematica/mobile",
    "mobile:prebuild": "npm run prebuild -w @codematica/mobile",
    "mobile:prebuild:ios": "npm run prebuild:ios -w @codematica/mobile",
    "mobile:pods": "npm run pods -w @codematica/mobile",
    "mobile:eas:login": "cd apps/mobile && eas login",
    "mobile:eas:init": "cd apps/mobile && eas init",
    "mobile:credentials:android": "cd apps/mobile && eas credentials --platform android",
    "mobile:credentials:ios": "cd apps/mobile && eas credentials --platform ios",
    "mobile:build:preview": "cd apps/mobile && eas build --profile preview --platform all",
    "mobile:build:android": "cd apps/mobile && eas build --profile production --platform android",
    "mobile:build:ios": "cd apps/mobile && eas build --profile production --platform ios",
    "mobile:build:all": "cd apps/mobile && eas build --profile production --platform all",
    "mobile:submit:android": "cd apps/mobile && eas submit --profile production --platform android --latest",
    "mobile:submit:ios": "cd apps/mobile && eas submit --profile production --platform ios --latest",
    "mobile:submit:all": "cd apps/mobile && eas submit --profile production --platform all --latest",
    "content:index": "tsx scripts/content/build-index.ts",
    "content:check": "tsx scripts/content/build-index.ts --check",
    "content:audio": "tsx scripts/content/build-japanese-audio.ts",
    "content:audio:generate": "tsx scripts/content/generate-japanese-audio.ts",
    "content:japanese:n5": "tsx scripts/content/build-japanese-n5.ts",
    "content:sync:supabase": "node --env-file=.env --import tsx scripts/content/sync-supabase.ts",
    "e2e:smoke": "npm run e2e:web:smoke",
    "e2e:web:smoke": "playwright test --config=apps/web/e2e/playwright.config.ts --grep @smoke",
    "e2e:web:regression": "playwright test --config=apps/web/e2e/playwright.config.ts --project=mobile-chromium --grep @regression",
    "e2e:web:release": "playwright test --config=apps/web/e2e/playwright.config.ts",
    "test:release": "npm run content:check && npm run lint && npm run typecheck && npm run mobile:doctor && npm run test:interview:python && npm run test:coverage && npm run test:mobile:coverage && npm run test:db && npm run build && npm run e2e:web:release",
    "mobile:e2e:android": "cd apps/mobile && NODE_OPTIONS=--no-deprecation eas workflow:run .eas/workflows/e2e-android-pr.yml",
    "mobile:e2e:release": "cd apps/mobile && NODE_OPTIONS=--no-deprecation eas workflow:run .eas/workflows/e2e-release.yml",
    "mobile:e2e:code-layout": "node apps/mobile/e2e/code-layout.mjs",
    "mobile:doctor": "npm run doctor -w @codematica/mobile",
    "linkedin": "node --env-file=.env --import tsx scripts/linkedin/cli.ts",
    "linkedin:models": "python3 scripts/linkedin/models.py",
    "linkedin:evaluate": "node --import tsx scripts/linkedin/evaluate-local.ts",
    "test:linkedin:preparation": "node --import tsx scripts/linkedin/smoke-preparation.ts",
    "test:linkedin:local": "node --import tsx scripts/linkedin/smoke-local.ts",
    "test:production:smoke": "node scripts/testing/production-smoke.mjs",
    "e2e:linkedin": "EDITORIAL_E2E=1 playwright test --config=apps/web/e2e/playwright.config.ts --project=mobile-chromium linkedin-admin.regression.spec.ts",
    "test:interview:python": "python3 scripts/content/verify-frontend-python.py && python3 scripts/content/verify-interview-audit.py",
    "brand:assets": "node scripts/brand/build-assets.mjs",
    "brand:check": "node scripts/brand/build-assets.mjs --check",
    "brand:preview": "node scripts/brand/capture-preview.mjs",
    "game:runtime": "tsx scripts/game/build-runtime.ts",
    "game:assets": "tsx scripts/game/build-assets.ts",
    "game:check": "node scripts/game/check-exports.mjs",
    "game:artifact-smoke": "node scripts/game/artifact-smoke.mjs",
    "game:flows": "tsx scripts/game/build-maestro.ts",
    "game:character-preview": "node scripts/game/capture-character-kit.mjs",
    "game:miniature-preview": "node scripts/game/capture-miniatures.mjs",
    "mobile:e2e:notebook-layout": "node apps/mobile/e2e/notebook-layout.mjs",
    "mobile:e2e:notebook-gestures": "node apps/mobile/e2e/notebook-gestures.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@radix-ui/react-select": "^2.2.6",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.562.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.15.0",
    "next": "^16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/css-tree": "3.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "1.4.11",
    "@vitest/coverage-v8": "^4.1.7",
    "eas-cli": "^20.5.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jest-junit": "^17.0.0",
    "jsdom": "^29.1.1",
    "pod-install": "^1.1.0",
    "react-native": "0.86.3",
    "sharp": "0.34.5",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "@expo/dom-webview": "57.0.1",
    "@expo/fingerprint": "0.20.13",
    "@expo/log-box": "57.0.4",
    "@expo/cli": "57.0.27",
    "@expo/devtools": "57.0.1",
    "@expo/metro-config": "57.0.12",
    "@expo/metro-runtime": "57.0.16",
    "@expo/router-server": "57.0.11",
    "babel-preset-expo": "57.0.13",
    "expo": "57.0.26",
    "expo-asset": "57.0.18",
    "expo-constants": "57.0.20",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-keep-awake": "57.0.2",
    "expo-modules-core": "57.0.20",
    "expo-modules-jsi": "57.1.1",
    "postcss": "^8.5.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
