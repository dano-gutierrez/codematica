{
  "name": "codematica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run dev -w @codematica/web",
    "web:dev": "npm run dev -w @codematica/web",
    "web:build": "npm run build -w @codematica/web",
    "web:start": "npm run start -w @codematica/web",
    "build": "npm run content:index && npm run build -w @codematica/web",
    "start": "npm run start -w @codematica/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck -w @codematica/core && npm run typecheck -w @codematica/ui && npm run typecheck -w @codematica/web && npm run typecheck -w @codematica/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mobile": "npm run test -w @codematica/mobile",
    "mobile:dev": "npm run dev -w @codematica/mobile",
    "mobile:android": "npm run android -w @codematica/mobile",
    "mobile:ios": "npm run ios -w @codematica/mobile",
    "mobile:prebuild": "npm run prebuild -w @codematica/mobile",
    "mobile:prebuild:ios": "npm run prebuild:ios -w @codematica/mobile",
    "mobile:pods": "npm run pods -w @codematica/mobile",
    "mobile:eas:login": "cd apps/mobile && eas login",
    "mobile:eas:init": "cd apps/mobile && eas init",
    "mobile:credentials:android": "cd apps/mobile && eas credentials --platform android",
    "mobile:credentials:ios": "cd apps/mobile && eas credentials --platform ios",
    "mobile:build:preview": "cd apps/mobile && eas build --profile preview --platform all",
    "mobile:build:android": "cd apps/mobile && eas build --profile production --platform android",
    "mobile:build:ios": "cd apps/mobile && eas build --profile production --platform ios",
    "mobile:build:all": "cd apps/mobile && eas build --profile production --platform all",
    "mobile:submit:android": "cd apps/mobile && eas submit --profile production --platform android --latest",
    "mobile:submit:ios": "cd apps/mobile && eas submit --profile production --platform ios --latest",
    "mobile:submit:all": "cd apps/mobile && eas submit --profile production --platform all --latest",
    "content:index": "tsx scripts/content/build-index.ts",
    "content:check": "tsx scripts/content/build-index.ts --check",
    "content:audio": "tsx scripts/content/build-japanese-audio.ts",
    "content:sync:supabase": "node --env-file=.env --import tsx scripts/content/sync-supabase.ts",
    "e2e:smoke": "playwright test --config=apps/web/e2e/playwright.config.ts",
    "mobile:doctor": "npm run doctor -w @codematica/mobile"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@radix-ui/react-select": "^2.2.6",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.562.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.15.0",
    "next": "^16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eas-cli": "^20.5.1",
    "expo": "57.0.10",
    "expo-constants": "57.0.9",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "pod-install": "^1.1.0",
    "react-native": "0.86.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "@expo/dom-webview": "57.0.1",
    "@expo/fingerprint": "0.20.6",
    "@expo/log-box": "57.0.2",
    "@expo/cli": "57.0.12",
    "@expo/devtools": "57.0.1",
    "@expo/metro-config": "57.0.7",
    "@expo/metro-runtime": "57.0.8",
    "@expo/router-server": "57.0.5",
    "babel-preset-expo": "57.0.5",
    "expo": "57.0.10",
    "expo-asset": "57.0.8",
    "expo-constants": "57.0.9",
    "expo-file-system": "57.0.1",
    "expo-font": "57.0.1",
    "expo-keep-awake": "57.0.1",
    "expo-modules-core": "57.0.9",
    "expo-modules-jsi": "57.0.4",
    "postcss": "^8.5.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2"
  }
}
